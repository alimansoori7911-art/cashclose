# نمونهٔ تنظیمات استقرار با داکر.
#
# این فایل را به `.env` کپی کنید و مقادیر را پر کنید:
#   cp .env.docker.example .env
#
# ⚠️  فایل `.env` هرگز نباید در گیت کامیت شود.

# ─── دیتابیس ───
POSTGRES_USER=cashclose
POSTGRES_DB=cashclose
# یک رمز تصادفی بسازید:
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# ─── احراز هویت ───
# حتماً تصادفی و حداقل ۳۲ کاراکتر:
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=12h

# ─── شبکه ───
# آدرسی که کاربران با آن به سامانه وصل می‌شوند. در محیط تولید باید
# https باشد وگرنه سرویس بالا نمی‌آید (قاعدهٔ فاز ۷).
# نمونهٔ اینترنتی:  https://cashclose.example.com
# نمونهٔ شبکهٔ داخلی با http، فقط اگر NODE_ENV=production نباشد.
CORS_ORIGINS=

# پورتی که nginx روی سرور می‌شنود. اگر ۸۰ اشغال است، مثلاً ۸۰۸۰ بگذارید.
WEB_PORT=80
