# ─── برنامه ───
NODE_ENV=development
PORT=3000
# مبدأهای مجاز برای CORS (با کاما جدا شوند)
CORS_ORIGINS=http://localhost:5173

# ─── دیتابیس ───
# قالب: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cashclose?schema=public"

# ─── احراز هویت ───
# در تولید حتماً با یک مقدار تصادفی قوی جایگزین شود:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="CHANGE_ME_IN_PRODUCTION_USE_A_LONG_RANDOM_STRING"
# انقضای توکن دسترسی (طبق تصمیم پروژه: ۱۲ ساعت)
JWT_EXPIRES_IN=12h
# اعتبار لینک بازیابی رمز عبور (دقیقه)
PASSWORD_RESET_TTL_MINUTES=30

# ─── ذخیره‌سازی فایل ───
# فعلاً فقط "local"؛ افزودن "s3" بدون تغییر کد سرویس‌ها ممکن است.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
# محدودیت‌های آپلود (طبق سند: حداکثر ۵ عکس، هرکدام تا ۳ مگابایت)
UPLOAD_MAX_FILE_SIZE_MB=3
UPLOAD_MAX_FILES_PER_SECTION=5

# ─── محدودیت نرخ درخواست ───
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
# سقف تلاش ناموفق ورود پیش از قفل موقت
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
