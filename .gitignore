# وابستگی‌ها
node_modules/
.npm/

# خروجی بیلد
dist/
build/
*.tsbuildinfo

# متغیرهای محیطی — هرگز کامیت نشوند
.env
.env.*
# نمونه‌ها استثنا هستند: فقط نام متغیرها را دارند، نه مقدارشان.
!.env.example
!.env.docker.example

# فایل‌های آپلودشدهٔ کاربران.
#
# مسیر با `/` شروع می‌شود تا فقط پوشهٔ ریشه را بگیرد. الگوی بدون مسیر
# (`uploads/`) هر پوشه‌ای به این نام را در هر عمقی نادیده می‌گرفت و
# ماژول `src/modules/uploads/` را هم بلعیده بود.
/uploads/
/apps/api/uploads/

# لاگ
*.log
npm-debug.log*
logs/

# ابزار توسعه
.vscode/*
!.vscode/extensions.json
.idea/
coverage/
.vitest/
.eslintcache

# سیستم‌عامل
.DS_Store
Thumbs.db
desktop.ini
